{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                t.token_id,\n                t.name,\n                t.symbol,\n                t.image_uri,\n                t.created_at,\n                t.total_supply,\n                m.market_type,\n                m.price\n            FROM token t\n            JOIN market m ON t.token_id = m.token_id\n            WHERE \n                LOWER(t.token_id) LIKE $1\n                OR LOWER(t.name) LIKE $1\n                OR LOWER(t.symbol) LIKE $1\n            ORDER BY m.price DESC\n            ",
