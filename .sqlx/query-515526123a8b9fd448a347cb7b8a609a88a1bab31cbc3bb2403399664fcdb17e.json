{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    cbr.round,\n                    cbr.level,\n                    cbr.token_id,\n                    crt.name,\n                    crt.symbol,\n                    crt.image_uri,\n                    cbr.amount,\n                    cbr.status,\n                    cbr.proof,\n                    cbr.transaction_hash,\n                    cbr.claimed_at\n                FROM chester_box_reward cbr\n                JOIN chester_reward_token crt ON crt.token_id = cbr.token_id\n                WHERE cbr.account_id = $1\n                  AND cbr.round = $2\n                ORDER BY cbr.level ASC, cbr.amount DESC\n                ",
