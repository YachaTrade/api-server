{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                p.account_id,\n                p.point,\n                a.nickname,\n                a.image_uri,\n                a.follower_count,\n                a.following_count,\n                ax.x_handle,\n                ax.x_image_uri,\n                ax.is_blue_label\n            FROM point p\n            JOIN account a ON p.account_id = a.account_id\n            LEFT JOIN account_x ax ON a.account_id = ax.account_id\n            ORDER BY p.point DESC\n            LIMIT $1\n            OFFSET $2\n            ",
