{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT \n                    s.account_id,\n                    s.token_id,\n                    t.symbol as token_symbol,\n                    t.image_uri as token_image,\n                    t.name as token_name,\n                    s.is_buy,\n                    s.native_amount,\n                    s.token_amount,\n                    s.created_at,\n                    s.transaction_hash\n                FROM swap s\n                JOIN token t ON s.token_id = t.token_id\n                WHERE s.account_id = $1\n                ORDER BY s.created_at DESC\n                LIMIT $2\n                OFFSET $3\n                ",
