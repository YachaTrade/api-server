{
  "db_name": "PostgreSQL",
  "query": "\n            WITH deleted_like AS (\n                DELETE FROM thread_likes\n                WHERE thread_id = $1 AND account_id = $2 AND token_id = $3\n                RETURNING thread_id\n            )\n            UPDATE thread t\n            SET likes_count = GREATEST(t.likes_count - 1, 0)\n            WHERE t.thread_id = $1\n              AND EXISTS (SELECT 1 FROM deleted_like)\n            RETURNING *\n            ",
