{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT a.account_id, a.nickname,a.bio, a.image_uri, a.follower_count, a.following_count,a.like_count\n            FROM follow f\n            JOIN account a ON f.following_id = a.account_id\n            WHERE f.follower_id = $1\n            ORDER BY a.account_id\n            LIMIT $2 OFFSET $3\n            ",
