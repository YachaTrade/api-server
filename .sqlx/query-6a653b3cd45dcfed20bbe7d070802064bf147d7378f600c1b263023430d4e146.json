  "query": "\n            SELECT a.account_id,\n            a.nickname,\n            a.image_uri,\n            a.bio,\n            a.follower_count,\n            a.following_count,\n            ax.x_handle,\n            ax.x_image_uri,\n            ax.is_blue_label\n            FROM account a\n            LEFT JOIN account_x ax ON a.account_id = ax.account_id\n            WHERE LOWER(a.account_id) = LOWER($1)\n            ",
