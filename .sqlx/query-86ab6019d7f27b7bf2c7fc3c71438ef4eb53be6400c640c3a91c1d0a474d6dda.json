{
  "db_name": "PostgreSQL",
  "query": "\n                    SELECT a2.account_id, a2.nickname, a2.bio, a2.image_uri, a2.follower_count, a2.following_count, a2.like_count\n                    FROM follow f\n                    JOIN account a1 ON f.follower_id = a1.account_id\n                    JOIN account a2 ON f.following_id = a2.account_id\n                    WHERE a1.nickname = $1\n                    LIMIT $2\n                    OFFSET $3\n                    ",
