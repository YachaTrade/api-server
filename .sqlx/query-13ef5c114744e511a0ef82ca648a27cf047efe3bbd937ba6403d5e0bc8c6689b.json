  "query": "\n            INSERT INTO account (account_id, image_uri, nickname, bio, follower_count, following_count, like_count)\n            VALUES ($1, $2, $3, $4, $5, $6, $7)\n            ON CONFLICT (account_id) \n            DO UPDATE SET\n                image_uri = $2,\n                nickname = $3,\n                bio = $4,\n                follower_count = $5,\n                following_count = $6,\n                like_count = $7\n                RETURNING *\n            ",
