{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                s.swap_id,\n                s.token_id,\n                s.is_buy,\n                s.native_amount,\n                s.token_amount,\n                s.created_at,\n                s.transaction_hash,\n                a.account_id,\n                a.nickname as account_nickname,\n                a.image_uri as account_image,\n                a.follower_count,\n                a.following_count\n            FROM swap s\n            JOIN account a ON s.sender = a.account_id\n            WHERE s.token_id = $1\n            ORDER BY s.created_at DESC\n            LIMIT $2\n            OFFSET $3\n            ",
