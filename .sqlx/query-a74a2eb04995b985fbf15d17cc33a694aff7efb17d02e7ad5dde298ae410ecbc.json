{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                b.balance as current_token_amount,\n                a.account_id,\n                a.nickname,\n                a.image_uri,\n                a.follower_count,\n                a.following_count\n            FROM balance b\n            JOIN account a ON b.account_id = a.account_id\n            WHERE b.token_id = $1 AND b.balance > 0\n            ORDER BY b.balance DESC\n            OFFSET $2 LIMIT $3\n            ",
