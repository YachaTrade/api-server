{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                p.account_id,\n                p.point,\n                a.nickname,\n                a.image_uri,\n                a.follower_count,\n                a.following_count\n            FROM point p\n            JOIN account a ON p.account_id = a.account_id\n            ORDER BY p.point DESC\n            LIMIT $1\n            OFFSET $2\n            ",
