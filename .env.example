# Database URLs
PRIMARY_DATABASE_URL=
REPLICA_DATABASE_URL=
REDIS_URL=

# PostgreSQL Primary (Writer) Pool Configuration
# 권장값: 개발(10-20), 중소규모(30-50), 대규모(100-200), 초대규모(200-500)
PG_PRIMARY_MAX_CONNECTIONS=50
# 권장값: MAX_CONNECTIONS의 10-20% (개발: 2-5, 중소규모: 5-10, 대규모: 20-40)
PG_PRIMARY_MIN_CONNECTIONS=5
# 권장값: PgBouncer 사용시 300-600초, 직접연결시 1800-3600초
PG_PRIMARY_MAX_LIFETIME_SECS=600    # 10 minutes
# 권장값: 낮은지연(5-10초), 일반(15-30초), 배치처리(60-120초)
PG_PRIMARY_ACQUIRE_TIMEOUT_SECS=15
# 권장값: PgBouncer 사용시 30-60초, 직접연결시 300-600초
PG_PRIMARY_IDLE_TIMEOUT_SECS=60
# 권장값: 개발(100-500), 중소규모(1000-2000), 대규모(3000-5000), PgBouncer 트랜잭션모드(1000+)
PG_PRIMARY_STATEMENT_CACHE_CAPACITY=1000

# PostgreSQL Replica (Reader) Pool Configuration
# 권장값: Primary보다 50-100% 더 많게 설정 (읽기 작업이 더 많은 경우)
PG_REPLICA_MAX_CONNECTIONS=50
# 권장값: 읽기 작업의 특성상 Primary보다 높게 설정 (개발: 5-10, 중소규모: 10-20, 대규모: 40-80)
PG_REPLICA_MIN_CONNECTIONS=10
# 권장값: Primary와 동일하거나 약간 더 길게 설정
PG_REPLICA_MAX_LIFETIME_SECS=600    # 10 minutes
# 권장값: 읽기 작업은 대체로 빠르므로 Primary와 동일하거나 약간 짧게
PG_REPLICA_ACQUIRE_TIMEOUT_SECS=15
# 권장값: Primary와 동일
PG_REPLICA_IDLE_TIMEOUT_SECS=60
# 권장값: 읽기 쿼리가 다양하므로 Primary보다 50-100% 크게 설정
PG_REPLICA_STATEMENT_CACHE_CAPACITY=2000

# Redis Pool Configuration
# 권장값: 개발(10-20), 중소규모(50-100), 대규모(128-256), 초대규모(256-512)
REDIS_POOL_MAX_SIZE=100
# 권장값: 실시간(1-5초), 일반(5-10초), 배치처리(30-60초)
REDIS_POOL_WAIT_TIMEOUT_SECS=5
# 권장값: 같은리전(1-3초), 다른리전(5-10초), 불안정네트워크(10-20초)
REDIS_POOL_CREATE_TIMEOUT_SECS=2
# 권장값: 안정환경(1-3초), 일반환경(3-5초), 불안정환경(5-10초)
REDIS_POOL_RECYCLE_TIMEOUT_SECS=1

# 환경별 권장 설정 가이드
# =====================
# 
# 개발 환경:
# - PostgreSQL: max_connections=10-20, min_connections=2-5, cache=100-500
# - Redis: max_size=10-20
#
# 스테이징/테스트 환경:
# - PostgreSQL: max_connections=30-50, min_connections=5-10, cache=1000-2000
# - Redis: max_size=50-100
#
# 프로덕션 환경 (중소규모):
# - PostgreSQL: max_connections=50-100, min_connections=10-20, cache=2000-3000
# - Redis: max_size=100-200
#
# 프로덕션 환경 (대규모):
# - PostgreSQL: max_connections=100-200, min_connections=20-40, cache=3000-5000
# - Redis: max_size=200-400
#
# Neon + PgBouncer 환경 특별 권장사항:
# - max_lifetime_secs: 300-600 (더 짧게 설정)
# - idle_timeout_secs: 30-60 (적극적인 연결 해제)
# - statement_cache_capacity: 1000-3000 (트랜잭션 풀링 모드에 최적화)

# Cache Expiration Settings
# ========================
# All values are in milliseconds unless specified otherwise

# Session expiration (in milliseconds)
# Default: 86400000 (24 hours)
EXPIRATION_SESSION_KEY=86400000

# Message cache expiration (in milliseconds)
# Default: 180000 (3 minutes)
MESSAGE_EXPIRATION=180000

# Order cache expiration
# Default: 1500 (1.5 seconds)
ORDER_EXPIRATION=1500

# Search results cache expiration
# Default: 15000 (15 seconds)
SEARCH_EXPIRATION=15000

# Token data cache expiration
# Default: 1500 (1.5 seconds)
TOKEN_EXPIRATION=1500

# Hold token cache expiration
# Default: 10000 (10 seconds)
HOLD_TOKEN_EXPIRATION=10000

# Token response cache expiration
# Default: 60000 (1 minute)
GET_TOKEN_RESPONSE_EXPIRATION=60000

# Token metadata cache expiration
# Default: 43200000 (12 hours)
GET_TOKEN_METADATA_EXPIRATION=43200000

# Hype token response cache expiration
# Default: 10000 (10 seconds)
GET_HYPE_TOKEN_RESPONSE_EXPIRATION=10000

# Chart data cache expiration
# Default: 5000 (5 seconds)
CHART_EXPIRATION=5000

# Treasury/Management Endpoints Cache
# ==================================

# Dev positions cache expiration
# Default: 5000 (5 seconds)
GET_DEV_POSITIONS_EXPIRATION=5000

# Holding token management cache expiration
# Default: 5000 (5 seconds)
GET_HOLDING_TOKEN_MANAGEMENT_EXPIRATION=5000

# Account locks cache expiration
# Default: 15000 (15 seconds)
GET_ACCOUNT_LOCKS_EXPIRATION=15000

# Account withdrawable lock cache expiration
# Default: 15000 (15 seconds)
GET_ACCOUNT_WITHDRAWABLE_LOCK_EXPIRATION=15000

# Token management history cache expiration
# Default: 5000 (5 seconds)
GET_TOKEN_MANAGEMENT_HISTORY_EXPIRATION=5000

# Token vaults response cache expiration (V2 vault list endpoint)
# Default: 30000 (30 seconds)
GET_TOKEN_VAULTS_RESPONSE_EXPIRATION=30000

# Quote tokens registry cache expiration (quote_token list endpoint)
# Default: 300000 (5 minutes — quote tokens are essentially static)
GET_QUOTE_TOKENS_RESPONSE_EXPIRATION=300000

# Profile gift-fee tokens cache expiration (V2 gift vault receiver endpoint)
# Default: 30000 (30 seconds)
GET_GIFT_FEE_RESPONSE_EXPIRATION=10000

# Chester Reward Token Contract Addresses
# ========================================
MON_CONTRACT_ADDRESS=0x3bd359C1119dA7Da1D913D1C4D2B7c461115433A
APR_CONTRACT_ADDRESS=0x0a332311633C0625f63CFc51EE33fC49826E0a3C

# Token Deployment Configuration
# ==============================

# V1 Bonding curve contract address (deployer for CREATE2)
V1_BONDING_CURVE=0x5FbDB2315678afecb367f032d93F642f64180aa3

# V1 Token implementation contract address (template for EIP-1167 minimal proxy)
V1_TOKEN_IMPL=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# V2 Bonding curve contract address (deployer for CREATE2)
V2_BONDING_CURVE=0x0000000000000000000000000000000000000000

# V2 Token implementation contract address (template for EIP-1167 minimal proxy)
V2_TOKEN_IMPL=0x0000000000000000000000000000000000000000

# Vanity address suffix for token addresses (e.g., "143" creates addresses ending in 143)
VANITY_ADDRESS_SUFFIX=143

# Server bind ====================================================
# IP and PORT the HTTP server listens on. Both fall back to defaults
# in code (IP="0.0.0.0", PORT="8000") if unset, but pin them
# explicitly per environment to avoid the v1 vs v2 same-port collision
# from sharing a host.
IP="0.0.0.0"
PORT="8000"

# Redis key prefix ================================================
# Prepended to every Redis key issued by this service. Empty string
# (default) = legacy behavior, no prefix. Set when sharing one Redis
# instance between v1 and v2:
#
#   REDIS_KEY_PREFIX="API_V2"   →  every key becomes "API_V2:<...>"
#
# Trailing colon is added automatically (don't include it).
#
# Startup flush behavior keys off this value:
#   - Empty prefix → startup flush is a no-op. We never run FLUSHALL
#     (too risky on a shared Redis instance).
#   - Non-empty prefix → SCAN MATCH <prefix>* COUNT 500 + DEL loop.
#     Only this service's keys are wiped; v1 keys stay intact.
REDIS_KEY_PREFIX=""

# Gift Bot Configuration (GIFT_ prefix) ================================
# All gift-bot settings consolidated here; prefix avoids collision with
# existing api-server vars. Semantics match gift-bot ProducerConfig +
# ConsumerConfig; only the env var names gain the GIFT_ prefix.

# X (Twitter) OAuth 1.0a — shared by CRC validation, signature, and reply
GIFT_X_OAUTH_CONSUMER_KEY=your_consumer_key_here
GIFT_X_OAUTH_CONSUMER_SECRET=your_consumer_secret_here
GIFT_X_OAUTH_ACCESS_TOKEN=your_access_token_here
GIFT_X_OAUTH_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# X webhook ID registered via POST /2/account_activity/webhooks
GIFT_X_WEBHOOK_ID=your_webhook_id_here

# Parser slots — values below are the gift-bot production defaults
GIFT_X_MENTION_ACCOUNT=nadfunnews
GIFT_X_ACTIVATION_PREFIX=Activating Gift for
GIFT_X_RECIPIENT_PREFIX=Fees will go to
GIFT_X_REQUIRED_HASHTAG=#Nadfun

# RPC endpoints (primary required; sub slots are optional fallbacks)
GIFT_MAIN_RPC_URL=https://rpc.monad.xyz
GIFT_SUB_RPC_URL_1=
GIFT_SUB_RPC_URL_2=

# Chain
GIFT_MONAD_CHAIN_ID=10143

# Gift vault contract address (EIP-55 checksum)
GIFT_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# Bot wallet private key — KEEP SECRET, never commit a real value
GIFT_BOT_PRIVATE_KEY=0xTODO_REPLACE_WITH_REAL_KEY

# Consumer tuning (optional — defaults shown)
# How often the poller checks for pending gifts (ms)
GIFT_CONSUMER_POLL_INTERVAL_MS=2000
# Time to wait for in-flight txs before graceful shutdown (ms)
GIFT_TX_GRACEFUL_DRAIN_MS=10000
# RPC read timeout per call before failing over to the next endpoint (ms)
GIFT_RPC_READ_TIMEOUT_MS=3000
# RPC send timeout for tx submission per endpoint (ms)
GIFT_RPC_SEND_TIMEOUT_MS=10000
# Confirmations before a tx is treated as final (currently informational)
GIFT_TX_CONFIRMATIONS=1
# Fallback-consumer sleep after claim before preflight (ms; 0 = primary mode)
GIFT_CONSUMER_WAIT_TIME_MS=0

# Safety flags — set to "true" to enable
# dry_run: skip on-chain sends; paused: pause consumer loop
GIFT_DRY_RUN=false
GIFT_PAUSED=false

# Reply-on-success worker — when "true", the leader posts a "🎁 Gift activated!"
# reply to the original tweet after setReceiver confirms. Reuses the four
# GIFT_X_OAUTH_* secrets above for OAuth 1.0a signing (no extra creds needed).
GIFT_X_REPLY_ENABLED=false